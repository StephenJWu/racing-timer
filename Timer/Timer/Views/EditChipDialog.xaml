<Window x:Class="Timer.Views.EditChipDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Timer.Converters"
        Title="编辑芯片"
        Width="450"
        Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                   Text="编辑芯片"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="{StaticResource TextColorBrush}"
                   Margin="0,0,0,20"/>

        <!-- 表单区域 -->
        <StackPanel Grid.Row="1">
            <!-- 芯片标签号码 -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="芯片标签号码 *"
                           FontSize="13"
                           Foreground="{StaticResource SecondaryTextColorBrush}"
                           Margin="0,0,0,6"/>
                <TextBox Text="{Binding LabelNumber, UpdateSourceTrigger=PropertyChanged}"
                         Height="36"
                         FontSize="14"/>
            </StackPanel>

            <!-- 芯片内部编号 -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="芯片内部编号 *"
                           FontSize="13"
                           Foreground="{StaticResource SecondaryTextColorBrush}"
                           Margin="0,0,0,6"/>
                <TextBox Text="{Binding InternalNumber, UpdateSourceTrigger=PropertyChanged}"
                         Height="36"
                         FontSize="14"/>
            </StackPanel>
        </StackPanel>

        <!-- 错误提示 -->
        <Border Grid.Row="2"
                Background="#fff2f0"
                BorderBrush="#ffccc7"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,16"
                Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="请修正以下错误："
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#cf1322"
                           Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding ValidationErrors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       FontSize="11"
                                       Foreground="#cf1322"
                                       Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 按钮 -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="取消"
                    Click="CancelButton_Click"
                    Padding="24,8"
                    Margin="0,0,12,0"
                    FontSize="13"/>
            <Button Content="保存"
                    Click="SaveButton_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="24,8"
                    FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>

