<UserControl x:Class="Timer.Views.GroupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Timer.Converters"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <converters:HexColorToBrushConverter x:Key="HexColorToBrushConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部查询区 -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="查询条件" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextColorBrush}" Margin="0,0,0,16"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 第一行 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="开始日期：" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <DatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding StartDate}" Height="36" Margin="0,0,16,0"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="结束日期：" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <DatePicker Grid.Row="0" Grid.Column="3" SelectedDate="{Binding EndDate}" Height="36" Margin="0,0,16,0"/>

                    <TextBlock Grid.Row="0" Grid.Column="4" Text="学校：" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox Grid.Row="0" Grid.Column="5" ItemsSource="{Binding Schools}" 
                              SelectedItem="{Binding SelectedSchool}" Height="36"/>

                    <!-- 第二行 -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="年级：" VerticalAlignment="Center" Margin="0,12,12,0"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Grades}" 
                              SelectedItem="{Binding SelectedGrade}" Height="36" Margin="0,12,16,0"/>

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="班级：" VerticalAlignment="Center" Margin="0,12,12,0"/>
                    <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding Classes}" 
                              SelectedItem="{Binding SelectedClass}" Height="36" Margin="0,12,16,0"/>

                    <TextBlock Grid.Row="1" Grid.Column="4" Text="组别：" VerticalAlignment="Center" Margin="0,12,12,0"/>
                    <ComboBox Grid.Row="1" Grid.Column="5" ItemsSource="{Binding Groups}" 
                              SelectedItem="{Binding SelectedGroup}" Height="36" Margin="0,12,0,0"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="查询" Command="{Binding QueryCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}" Width="120" Margin="0,0,12,0"/>
                    <Button Content="导出分组结果" Command="{Binding ExportCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}" Width="140" Background="#22c55e" BorderBrush="#22c55e"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 中间分组列表标题 -->
        <TextBlock Grid.Row="1" Text="分组列表" FontSize="16" FontWeight="Bold" 
                   Foreground="{StaticResource TextColorBrush}" Margin="0,0,0,8"/>

        <!-- 中间分组列表 DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,16">
            <DataGrid ItemsSource="{Binding RaceGroups}" 
                      SelectedItem="{Binding SelectedRaceGroup}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      CanUserAddRows="False" 
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column" 
                      GridLinesVisibility="None"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="学校" Binding="{Binding School}" Width="*"/>
                    <DataGridTextColumn Header="年级" Binding="{Binding Grade}" Width="100"/>
                    <DataGridTextColumn Header="班级" Binding="{Binding Class}" Width="100"/>
                    <DataGridTextColumn Header="组别" Binding="{Binding GroupName}" Width="100"/>
                    
                    <!-- 芯片组列（带颜色块） -->
                    <DataGridTemplateColumn Header="芯片组" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Rectangle Width="16" Height="16" 
                                               Fill="{Binding ChipGroupColor, Converter={StaticResource HexColorToBrushConverter}}" 
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ChipGroupName}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTextColumn Header="数量" Binding="{Binding ParticipantCount}" Width="80"/>
                    
                    <!-- 操作列 -->
                    <DataGridTemplateColumn Header="操作" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="编辑" 
                                            Command="{Binding DataContext.EditRaceGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource TableEditButtonStyle}" 
                                            Margin="0,0,8,0"/>
                                    <Button Content="删除" 
                                            Command="{Binding DataContext.DeleteRaceGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource TableDeleteButtonStyle}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 底部人员详情标题 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <Rectangle Width="4" Height="20" Fill="{StaticResource PrimaryColorBrush}" Margin="0,0,8,0"/>
            <TextBlock Text="分组详情" FontSize="16" FontWeight="Bold" 
                       Foreground="{StaticResource TextColorBrush}"/>
        </StackPanel>

        <!-- 底部人员详情 DataGrid -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <!-- 人员列表 -->
                <DataGrid ItemsSource="{Binding Participants}" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column" 
                          GridLinesVisibility="None"
                          Visibility="{Binding SelectedRaceGroup, Converter={StaticResource NullToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="组内序号" Binding="{Binding GroupSequenceNumber}" Width="80"/>
                        <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="性别" Binding="{Binding Gender}" Width="80"/>
                        <DataGridTextColumn Header="准考证号" Binding="{Binding ExamNumber}" Width="120"/>
                        <DataGridTextColumn Header="芯片标签号码" Binding="{Binding ChipNumber}" Width="150"/>
                        <DataGridTextColumn Header="芯片内部号码" Binding="{Binding ChipInternalNumber}" Width="150"/>
                        
                        <!-- 操作列 -->
                        <DataGridTemplateColumn Header="操作" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="编辑" 
                                                Command="{Binding DataContext.EditParticipantCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TableEditButtonStyle}" 
                                                Margin="0,0,8,0"/>
                                        <Button Content="删除" 
                                                Command="{Binding DataContext.DeleteParticipantCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TableDeleteButtonStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 空状态提示 -->
                <TextBlock Text="请选择上方分组查看详情" 
                           FontSize="14" Foreground="{StaticResource SecondaryTextColorBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding SelectedRaceGroup, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
