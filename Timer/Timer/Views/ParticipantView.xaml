<UserControl x:Class="Timer.Views.ParticipantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Timer.Converters"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 筛选区域卡片 -->
        <Border Grid.Row="0" 
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,16">
            <StackPanel>
                <!-- 标题 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Width="24" Height="24" 
                            Background="{StaticResource PrimaryColorBrush}" 
                            CornerRadius="4" 
                            Margin="0,0,8,0">
                        <TextBlock Text="👥" 
                                   FontSize="14" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="参赛人员" 
                               FontSize="18" 
                               FontWeight="Bold"
                               Foreground="{StaticResource TextColorBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 筛选控件 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 开始日期 -->
                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,12,12">
                        <TextBlock Text="开始日期" 
                                   FontSize="12" 
                                   Foreground="{StaticResource SecondaryTextColorBrush}"
                                   Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedDateFormat="Short"
                                    Width="140"
                                    Height="32"/>
                    </StackPanel>

                    <!-- 结束日期 -->
                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,12,12">
                        <TextBlock Text="结束日期" 
                                   FontSize="12" 
                                   Foreground="{StaticResource SecondaryTextColorBrush}"
                                   Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding EndDate, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedDateFormat="Short"
                                    Width="140"
                                    Height="32"/>
                    </StackPanel>

                    <!-- 学校 -->
                    <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,12,12">
                        <TextBlock Text="学校" 
                                   FontSize="12" 
                                   Foreground="{StaticResource SecondaryTextColorBrush}"
                                   Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Schools}"
                                  SelectedItem="{Binding SelectedSchool, UpdateSourceTrigger=PropertyChanged}"
                                  Width="140"
                                  Height="32">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- 年级 -->
                    <StackPanel Grid.Column="3" Grid.Row="0" Margin="0,0,12,12">
                        <TextBlock Text="年级" 
                                   FontSize="12" 
                                   Foreground="{StaticResource SecondaryTextColorBrush}"
                                   Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Grades}"
                                  SelectedItem="{Binding SelectedGrade, UpdateSourceTrigger=PropertyChanged}"
                                  Width="140"
                                  Height="32">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Grades.Count}" Value="0">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- 班级 -->
                    <StackPanel Grid.Column="4" Grid.Row="0" Margin="0,0,12,12">
                        <TextBlock Text="班级" 
                                   FontSize="12" 
                                   Foreground="{StaticResource SecondaryTextColorBrush}"
                                   Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Classes}"
                                  SelectedItem="{Binding SelectedClass, UpdateSourceTrigger=PropertyChanged}"
                                  Width="140"
                                  Height="32">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Classes.Count}" Value="0">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- 组别 -->
                    <StackPanel Grid.Column="5" Grid.Row="0" Margin="0,0,12,12">
                        <TextBlock Text="组别" 
                                   FontSize="12" 
                                   Foreground="{StaticResource SecondaryTextColorBrush}"
                                   Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding GroupNames}"
                                  SelectedItem="{Binding SearchFilter.GroupName, UpdateSourceTrigger=PropertyChanged}"
                                  Width="140"
                                  Height="32">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GroupNames.Count}" Value="0">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- 查询按钮：紧贴筛选项后面 -->
                    <Button Grid.Column="6"
                            Grid.Row="0"
                            Content="查询"
                            Command="{Binding SearchCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            VerticalAlignment="Bottom"
                            Margin="0,0,12,12"/>

                    <!-- 导入按钮：单独最右边 -->
                    <Button Grid.Column="8"
                            Grid.Row="0"
                            Content="导入人员信息"
                            Command="{Binding ImportCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,12"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 导入进度和结果 -->
        <Border Grid.Row="1" 
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,16"
                Visibility="{Binding ImportResult, Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel>
                <ProgressBar Value="{Binding ImportProgress}" 
                             Maximum="100" 
                             Height="8" 
                             Margin="0,0,0,8"
                             Background="{StaticResource BorderColorBrush}"
                             Foreground="{StaticResource PrimaryColorBrush}"/>
                <TextBlock Text="{Binding ImportResult, StringFormat='导入结果：成功 {0.SuccessCount} 条，失败 {0.FailureCount} 条'}"
                           FontSize="12"
                           Foreground="{StaticResource SecondaryTextColorBrush}"
                           Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding ImportResult.Errors}" 
                              MaxHeight="150"
                              Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" 
                                       FontSize="11"
                                       Foreground="#ff4d4f"
                                       Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 数据表格卡片 -->
        <Border Grid.Row="2" 
                Style="{StaticResource CardStyle}">
            <StackPanel>
                <!-- 顶部：记录数 + 批量操作 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding TotalCount, StringFormat='共找到 {0} 条记录'}"
                               FontSize="14"
                               Foreground="{StaticResource TextColorBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="删除所选"
                                Command="{Binding BatchDeleteCommand}"
                                Padding="16,8"
                                FontSize="12"
                                Background="#ff4d4f"
                                Foreground="White"
                                BorderThickness="0"/>
                    </StackPanel>
                </Grid>

                <!-- 数据表格 -->
                <DataGrid ItemsSource="{Binding Participants}"
                          SelectedItem="{Binding SelectedParticipant}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Height="400">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="比赛日期" Binding="{Binding Date, StringFormat=yyyy-M-d}" Width="120"/>
                        <DataGridTextColumn Header="学校" Binding="{Binding School}" Width="120"/>
                        <DataGridTextColumn Header="年级" Binding="{Binding Grade}" Width="100"/>
                        <DataGridTextColumn Header="班级" Binding="{Binding Class}" Width="100"/>
                        <DataGridTextColumn Header="组别" Binding="{Binding GroupName}" Width="120"/>
                        <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="120"/>
                        <DataGridTextColumn Header="性别" Binding="{Binding Gender}" Width="80"/>
                        <DataGridTextColumn Header="准考证号" Binding="{Binding ExamNumber}" Width="140"/>
                        <DataGridTemplateColumn Header="操作" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="编辑"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="8,4"
                                                FontSize="11"
                                                Margin="0,0,8,0"
                                                Cursor="Hand"/>
                                        <Button Content="删除"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Padding="8,4"
                                                FontSize="11"
                                                Background="#ff4d4f"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Cursor="Hand"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- 分页控件 -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="上一页" 
                        Command="{Binding PreviousPageCommand}"
                        Padding="12,6"
                        Margin="0,0,8,0"
                        FontSize="12"/>
                <TextBlock Text="{Binding CurrentPage, StringFormat='第 {0} 页'}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource TextColorBrush}"
                           Margin="0,0,8,0"/>
                <TextBlock Text="{Binding TotalPages, StringFormat='共 {0} 页'}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource SecondaryTextColorBrush}"
                           Margin="0,0,8,0"/>
                <Button Content="下一页" 
                        Command="{Binding NextPageCommand}"
                        Padding="12,6"
                        FontSize="12"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
