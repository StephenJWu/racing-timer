<UserControl x:Class="Timer.Views.RaceTimerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Timer.Converters"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:HexColorToBrushConverter x:Key="HexColorToBrushConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题和比赛选择区域 -->
        <Border Grid.Row="0" 
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,16">
            <StackPanel>
                <!-- 标题 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Width="24" Height="24" 
                            CornerRadius="4" 
                            Margin="0,0,8,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3b82f6" Offset="0"/>
                                <GradientStop Color="#1d4ed8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="⏱️" 
                                   FontSize="14" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="比赛计时" 
                               FontSize="18" 
                               FontWeight="Bold"
                               Foreground="{StaticResource TextColorBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 比赛选择和信息 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="比赛分组:" 
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextColorBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding RaceGroups}"
                              SelectedItem="{Binding SelectedRaceGroup}"
                              DisplayMemberPath="DisplayName"
                              Width="300"
                              Height="36"
                              IsEnabled="{Binding IsRaceActive, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                              Margin="0,0,12,0"/>

                    <Button Grid.Column="2"
                            Content="加载"
                            Command="{Binding SelectRaceGroupCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="36"
                            Padding="20,8"
                            Margin="0,0,12,0"/>

                    <StackPanel Grid.Column="3" 
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <TextBlock Text="总圈数:" 
                                   FontSize="13"
                                   Foreground="{StaticResource SecondaryTextColorBrush}"
                                   Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding TotalLaps}" 
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryColorBrush}"/>
                        <TextBlock Text="圈" 
                                   FontSize="13"
                                   Foreground="{StaticResource SecondaryTextColorBrush}"
                                   Margin="2,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" 
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <TextBlock Text="参赛人数:" 
                                   FontSize="13"
                                   Foreground="{StaticResource SecondaryTextColorBrush}"
                                   Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding ParticipantCount}" 
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryColorBrush}"/>
                        <TextBlock Text="人" 
                                   FontSize="13"
                                   Foreground="{StaticResource SecondaryTextColorBrush}"
                                   Margin="2,0,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 加载指示器 -->
        <Border Grid.Row="1"
                Background="#fff9e6"
                BorderBrush="#ffe58f"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,8"
                Margin="0,0,0,16"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⏳" FontSize="14" Margin="0,0,8,0"/>
                <TextBlock Text="正在加载..." 
                           FontSize="13"
                           Foreground="#8c8c8c"/>
            </StackPanel>
        </Border>

        <!-- 主要内容区域：计时器 + 参赛者列表 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：大屏计时器区域 -->
            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 状态指示器 -->
                    <StackPanel Grid.Row="0" 
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,20">
                        <Ellipse Width="12" Height="12" 
                                 Fill="{Binding StatusColor, Converter={StaticResource HexColorToBrushConverter}}"
                                 Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding StatusText}" 
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding StatusColor, Converter={StaticResource HexColorToBrushConverter}}"/>
                    </StackPanel>

                    <!-- 计时器显示 -->
                    <Border Grid.Row="1"
                            CornerRadius="8"
                            Padding="20"
                            VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#f0f9ff" Offset="0"/>
                                <GradientStop Color="#e0f2fe" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="计时器" 
                                       FontSize="14"
                                       Foreground="{StaticResource SecondaryTextColorBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding ElapsedTimeDisplay}" 
                                       FontSize="48"
                                       FontWeight="Bold"
                                       FontFamily="Consolas"
                                       Foreground="#1e40af"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 控制按钮组 -->
                    <StackPanel Grid.Row="2" 
                                Margin="0,20,0,0">
                        <!-- 开始按钮 -->
                        <Button Content="开始比赛"
                                Command="{Binding StartRaceCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="44"
                                FontSize="16"
                                Margin="0,0,0,12"
                                Visibility="{Binding CanStart, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <!-- 暂停按钮 -->
                        <Button Content="暂停比赛"
                                Command="{Binding PauseRaceCommand}"
                                Height="44"
                                FontSize="16"
                                Margin="0,0,0,12"
                                Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="#faad14"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 继续按钮 -->
                        <Button Content="继续比赛"
                                Command="{Binding ResumeRaceCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="44"
                                FontSize="16"
                                Margin="0,0,0,12"
                                Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <!-- 停止按钮 -->
                        <Button Content="停止比赛"
                                Command="{Binding StopRaceCommand}"
                                Height="44"
                                FontSize="16"
                                Visibility="{Binding CanStop, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="#f5222d"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右侧：参赛者实时成绩列表 -->
            <Border Grid.Column="2"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 列表标题 -->
                    <TextBlock Grid.Row="0"
                               Text="参赛者实时成绩"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextColorBrush}"
                               Margin="0,0,0,16"/>

                    <!-- 参赛者列表 -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ParticipantTimings}"
                              AutoGenerateColumns="False"
                              CanUserSortColumns="True"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="True">
                        <DataGrid.Columns>
                            <!-- 排名 -->
                            <DataGridTextColumn Header="排名" 
                                                Binding="{Binding Rank}" 
                                                Width="60"
                                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 号码布 -->
                            <DataGridTextColumn Header="号码布" 
                                                Binding="{Binding BibNumber}" 
                                                Width="80"
                                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 姓名 -->
                            <DataGridTextColumn Header="姓名" 
                                                Binding="{Binding Name}" 
                                                Width="100"
                                                IsReadOnly="True"/>

                            <!-- 当前圈数 -->
                            <DataGridTextColumn Header="当前圈" 
                                                Binding="{Binding CurrentLap}" 
                                                Width="80"
                                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 累计用时 -->
                            <DataGridTextColumn Header="累计用时" 
                                                Binding="{Binding TotalTimeFormatted}" 
                                                Width="120"
                                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 最后一圈 -->
                            <DataGridTextColumn Header="最后一圈" 
                                                Binding="{Binding LastLapTimeFormatted}" 
                                                Width="120"
                                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="{StaticResource SecondaryTextColorBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 状态 -->
                            <DataGridTextColumn Header="状态" 
                                                Binding="{Binding Status}" 
                                                Width="80"
                                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 操作 -->
                            <DataGridTemplateColumn Header="操作" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="记圈"
                                                Command="{Binding DataContext.RecordLapCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TableEditButtonStyle}"
                                                HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>

                        <!-- 行样式：高亮领先者 -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLeading}" Value="True">
                                        <Setter Property="Background" Value="#fff7e6"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                        <Setter Property="Background" Value="#f6ffed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
